---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { site, assetUrl } from '../data/site';
import badgeSvg from '../assets/domovenka.svg?url';
import { getImage } from 'astro:assets';
import badge from '../assets/domovenka-social.png';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = await getImage({src: badge, width: 550, format: 'png'});
const imageUrl = Astro.site ? new URL(socialImage.src, Astro.site).href : undefined;
---
<!doctype html>
<html lang="sk"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#192B55"/><title>{site.name} | Skauting Košice – Nad jazerom</title><meta name="description" content={site.description}/><link rel="icon" type="image/png" sizes="64x64" href={assetUrl('favicon.png')}/><link rel="icon" type="image/svg+xml" href={badgeSvg}/>{canonical && <link rel="canonical" href={canonical}/>}
<meta property="og:type" content="website"/><meta property="og:locale" content="sk_SK"/><meta property="og:title" content={site.name}/><meta property="og:description" content={site.description}/>{canonical && <meta property="og:url" content={canonical}/>} {imageUrl && <meta property="og:image" content={imageUrl}/>}<meta property="og:image:alt" content="Domovenka zboru Dzive Labute"/><meta name="twitter:card" content="summary"/>
</head><body><a class="skip-link" href="#obsah">Preskočiť na obsah</a><slot/></body></html>
