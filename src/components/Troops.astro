---
import { site } from '../data/site';
---

<section id="oddiely" class="section troops" aria-labelledby="troops-title">
  <div class="container">
    <h2 id="troops-title">Naše tri oddiely</h2>
    <ul class="troop-grid" role="list">
      {site.troops.map((troop) => (
        <li class="troop-card">
          <p class="troop-number">{troop.number}. oddiel</p>
          <h3>{troop.name}</h3>
          <p class="troop-members">
            {troop.group}
            {troop.age && <span class="troop-age">{troop.age}</span>}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .troops {
    background: var(--color-navy);
    color: white;
  }

  .troops h2 {
    margin-bottom: 32px;
  }

  .troop-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .troop-card {
    --troop-accent: var(--color-turquoise);
    display: flex;
    flex-direction: column;
    padding: clamp(22px, 3vw, 34px);
    border: 1px solid #ffffff26;
    border-top: 3px solid var(--troop-accent);
    border-radius: 10px;
    background: #ffffff0c;
  }

  .troop-card:nth-child(2) { --troop-accent: var(--color-sun); }
  .troop-card:nth-child(3) { --troop-accent: #bcccf6; }

  .troop-number {
    margin-bottom: 14px;
    color: var(--troop-accent);
    font-size: .875rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .troop-card h3 {
    margin-bottom: 24px;
    font-size: clamp(1.35rem, 2.6vw, 2rem);
  }

  .troop-members {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: auto 0 0;
    padding-top: 15px;
    border-top: 1px solid #ffffff26;
    color: #e2e9f8;
  }

  .troop-age {
    border-radius: 999px;
    background: #ffffff14;
    padding: 2px 10px;
    font-size: .875rem;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .troop-grid { grid-template-columns: 1fr; }
    .troops h2 { margin-bottom: 24px; }
  }
</style>
