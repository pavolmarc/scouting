---
import { socialLinks } from '../data/site';
interface Props { iconsOnly?: boolean; }
const { iconsOnly = false } = Astro.props;
---
<ul class:list={['social-links', { 'social-icons': iconsOnly }]} aria-label="Sociálne siete">
  {socialLinks.map(link => <li><a href={link.url} rel="noopener noreferrer" aria-label={iconsOnly ? link.label : undefined} title={iconsOnly ? link.label : undefined}>
    {iconsOnly ? <svg width="23" height="23" viewBox="0 0 24 24" aria-hidden="true">
      {link.label === 'Facebook' ? <path fill="currentColor" d="M24 12a12 12 0 1 0-13.875 11.855v-8.386H7.078V12h3.047V9.356c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.234 2.686.234v2.953h-1.513c-1.491 0-1.956.925-1.956 1.874V12h3.328l-.532 3.469h-2.796v8.386A12.003 12.003 0 0 0 24 12Z"/> : <g fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></g>}
    </svg> : link.label}
  </a></li>)}
</ul>
